# Pins for the differential conformance test against the official HL7 FHIR Validator
# (diagnostics HL7ValidatorConformanceTest, run by scripts/hl7-validator.sh and CI's
# hl7-validator job). CI caches the jar and FHIR packages keyed by this file's hash.
#
# To bump: set VALIDATOR_VERSION to a release of hapifhir/org.hl7.fhir.core at least
# two weeks old where you can, set VALIDATOR_SHA256 to the sha256sum of that release's
# validator_cli.jar, run `bash scripts/hl7-validator.sh warm test`, and review every
# new disagreement (diagnostics/src/test/resources/conformance-corpus/README.md).
# fhir-crd-router's fhir-validator/run.sh pins the same release; keep them together.
VALIDATOR_VERSION=7.0.2
VALIDATOR_SHA256=e3e50f06b806437821b7aef8189a1b790415cb96c5036e0812ed62981452b377
# The CRD version the response checks claim (the router validates CRD 2.2.1).
IG=hl7.fhir.us.davinci-crd#2.2.1
FHIR_VERSION=4.0.1
# The HL7 tools package's logical model for a CDS Hooks response (hl7.fhir.uv.tools.r4,
# a dependency of the CRD package), so cards are judged as well as the FHIR resources.
PROFILE=http://hl7.org/fhir/tools/StructureDefinition/CDSHooksResponse
