<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>io.github.dflippojr</groupId>
  <artifactId>payer-onboarding-workbench-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>payer-onboarding-workbench</name>
  <description>Configure a synthetic payer connection, inspect discovery, run sample CDS Hooks requests, and explain failures.</description>

  <licenses>
    <license>
      <name>MIT</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>

  <modules>
    <module>workbench-core</module>
    <module>mock-payers</module>
    <module>diagnostics</module>
    <module>samples</module>
    <module>workbench-app</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <!-- Installed locally by scripts/install-crd-router.sh from the pinned commit; not on Maven Central yet. -->
    <fhir-crd-router.version>0.1.0-SNAPSHOT</fhir-crd-router.version>
    <!-- SonarCloud (see .github/workflows/sonar.yml). Each module's JaCoCo XML report is picked up from its default path. -->
    <sonar.organization>dflippojr</sonar.organization>
    <sonar.projectKey>dflippojr_payer-onboarding-workbench</sonar.projectKey>
    <sonar.host.url>https://sonarcloud.io</sonar.host.url>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.github.dflippojr</groupId>
        <artifactId>directory-core</artifactId>
        <version>${fhir-crd-router.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.dflippojr</groupId>
        <artifactId>client-sdk</artifactId>
        <version>${fhir-crd-router.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.dflippojr</groupId>
        <artifactId>workbench-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.dflippojr</groupId>
        <artifactId>mock-payers</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.dflippojr</groupId>
        <artifactId>diagnostics</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.dflippojr</groupId>
        <artifactId>samples</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <!-- Coverage for SonarCloud; version managed by spring-boot-starter-parent. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
