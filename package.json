{
  "name": "payer-workbench-ui-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test:ui": "playwright test --workers=1",
    "ui:start": "node scripts/ui-instance.mjs start",
    "ui:stop": "node scripts/ui-instance.mjs stop",
    "test:ui-instance": "node --test scripts/ui-instance.test.mjs",
    "test:lifecycle": "node --experimental-vm-modules --test --test-timeout=10000 scripts/workbench-lifecycle.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0"
  }
}
