<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.dflippojr</groupId>
    <artifactId>payer-onboarding-workbench-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>workbench-app</artifactId>
  <name>workbench-app</name>
  <description>Spring Boot app: REST API and static browser UI for the onboarding workbench.</description>

  <dependencies>
    <dependency>
      <groupId>io.github.dflippojr</groupId>
      <artifactId>workbench-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.dflippojr</groupId>
      <artifactId>mock-payers</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.dflippojr</groupId>
      <artifactId>diagnostics</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.dflippojr</groupId>
      <artifactId>samples</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.dflippojr</groupId>
      <artifactId>client-sdk</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <!-- META-INF/build-info.properties: the version stamped on exported reports. -->
            <goals>
              <goal>build-info</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
