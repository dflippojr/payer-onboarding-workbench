<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.dflippojr</groupId>
    <artifactId>payer-onboarding-workbench-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>diagnostics</artifactId>
  <name>diagnostics</name>
  <description>Diagnostic checks and the engine that runs them over run observations.</description>

  <properties>
    <!-- JaCoCo LINE coverage floor (see the parent pom): measured 92.48% minus 1 point. Only ever raise it. -->
    <jacoco.line.floor>0.914</jacoco.line.floor>
    <!-- pitest mutation score floor (-P mutation, scripts/mutation.sh): measured 81% (536 of 658 mutants) minus 2 points. Only ever raise it. -->
    <pitest.mutation.floor>79</pitest.mutation.floor>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.dflippojr</groupId>
      <artifactId>client-sdk</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.dflippojr</groupId>
      <artifactId>workbench-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The conformance corpus holds the mock payers' own answers to the samples. -->
    <dependency>
      <groupId>io.github.dflippojr</groupId>
      <artifactId>mock-payers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.dflippojr</groupId>
      <artifactId>samples</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <profiles>
    <!-- Mutation testing: bash scripts/mutation.sh runs it, and CI's mutation job (inside gate).
         The build fails when the mutation score drops below pitest.mutation.floor. CI caches the
         report by scripts/mutation-fingerprint.mjs (this module, the modules it depends on, Maven
         and the JDK), so unchanged inputs are not analysed again. -->
    <profile>
      <id>mutation</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <version>1.30.0</version>
            <dependencies>
              <dependency>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-junit5-plugin</artifactId>
                <version>1.2.3</version>
              </dependency>
            </dependencies>
            <executions>
              <execution>
                <id>mutation</id>
                <phase>verify</phase>
                <goals><goal>mutationCoverage</goal></goals>
              </execution>
            </executions>
            <configuration>
              <targetClasses>
                <param>io.github.dflippojr.payerworkbench.diagnostics.*</param>
              </targetClasses>
              <targetTests>
                <param>io.github.dflippojr.payerworkbench.diagnostics.*</param>
              </targetTests>
              <!-- Needs the HL7 validator; scripts/hl7-validator.sh runs it. -->
              <excludedGroups>
                <param>hl7-validator</param>
              </excludedGroups>
              <threads>4</threads>
              <mutationThreshold>${pitest.mutation.floor}</mutationThreshold>
              <timestampedReports>false</timestampedReports>
              <outputFormats>
                <param>XML</param>
                <param>HTML</param>
              </outputFormats>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
